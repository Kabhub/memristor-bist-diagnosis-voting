## ZedBoard 100 MHz programmable-logic clock
set_property PACKAGE_PIN Y9 [get_ports GCLK]
set_property IOSTANDARD LVCMOS33 [get_ports GCLK]
create_clock -add -name GCLK -period 10.000 -waveform {0.000 5.000} [get_ports GCLK]

## Asynchronous board controls enter two-stage synchronizers in the top level.
## Cut only the external-port-to-synchronizer paths; register-to-register paths
## inside each synchronizer remain timed by GCLK.
set_false_path -from [get_ports {BTNC BTNU BTNR SW[*]}] \
               -to [get_cells -hier -filter {ASYNC_REG == TRUE}]

## Push buttons: BTNC=start BIST, BTNU=reset, BTNR=OLED safe on/off
set_property PACKAGE_PIN P16 [get_ports BTNC]
set_property PACKAGE_PIN T18 [get_ports BTNU]
set_property PACKAGE_PIN R18 [get_ports BTNR]
set_property IOSTANDARD LVCMOS18 [get_ports {BTNC BTNU BTNR}]

## Slide switches
set_property PACKAGE_PIN F22 [get_ports {SW[0]}]
set_property PACKAGE_PIN G22 [get_ports {SW[1]}]
set_property PACKAGE_PIN H22 [get_ports {SW[2]}]
set_property PACKAGE_PIN F21 [get_ports {SW[3]}]
set_property PACKAGE_PIN H19 [get_ports {SW[4]}]
set_property PACKAGE_PIN H18 [get_ports {SW[5]}]
set_property PACKAGE_PIN H17 [get_ports {SW[6]}]
set_property PACKAGE_PIN M15 [get_ports {SW[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {SW[*]}]

## User LEDs
set_property PACKAGE_PIN T22 [get_ports {LD[0]}]
set_property PACKAGE_PIN T21 [get_ports {LD[1]}]
set_property PACKAGE_PIN U22 [get_ports {LD[2]}]
set_property PACKAGE_PIN U21 [get_ports {LD[3]}]
set_property PACKAGE_PIN V22 [get_ports {LD[4]}]
set_property PACKAGE_PIN W22 [get_ports {LD[5]}]
set_property PACKAGE_PIN U19 [get_ports {LD[6]}]
set_property PACKAGE_PIN U14 [get_ports {LD[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {LD[*]}]

## On-board 128x32 OLED display (Bank 13, fixed 3.3 V)
set_property PACKAGE_PIN U10  [get_ports OLED_DC]
set_property PACKAGE_PIN U9   [get_ports OLED_RES]
set_property PACKAGE_PIN AB12 [get_ports OLED_SCLK]
set_property PACKAGE_PIN AA12 [get_ports OLED_SDIN]
set_property PACKAGE_PIN U11  [get_ports OLED_VBAT]
set_property PACKAGE_PIN U12  [get_ports OLED_VDD]
set_property IOSTANDARD LVCMOS33 [get_ports {OLED_DC OLED_RES OLED_SCLK OLED_SDIN OLED_VBAT OLED_VDD}]

## LD outputs are human-observed, and the low-speed OLED link is generated by
## the FPGA rather than sampled against GCLK by a synchronous receiver.  These
## ports therefore have no external GCLK setup/hold requirement.  Internal
## register-to-register paths that generate the outputs remain fully timed.
set_false_path -to [get_ports {
    LD[*]
    OLED_DC
    OLED_RES
    OLED_SCLK
    OLED_SDIN
    OLED_VBAT
    OLED_VDD
}]
